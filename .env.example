# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital_assistant
DB_TEST_NAME=hospital_test
# Owner role: creates/drops tables (scripts, tests). Never used by the running API.
DB_OWNER_USER=hospital_owner
DB_OWNER_PASSWORD=change-me
# App role: used by the running API. Least privilege, cannot UPDATE/DELETE audit rows.
DB_APP_USER=hospital_app
DB_APP_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=120

# --- LLM ---
# Primary provider: groq | gemini. The other one is used as a fallback when its key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Models ---
# Where BGE-M3, the reranker and Docling models are cached.
HF_HOME=D:/cache/huggingface
# Set to false for the first run so models can download, then true to run fully offline.
HF_OFFLINE=true
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
